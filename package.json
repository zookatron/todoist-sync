{
  "name": "todoist-sync",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "run-p dev:web dev:worker",
    "dev:web": "react-router dev",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "run-s build:web build:worker build:migrate",
    "build:web": "react-router build",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/worker/index.js",
    "build:migrate": "esbuild migrate/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/migrate/index.js",
    "start": "react-router-serve ./build/server/index.js",
    "worker": "node build/worker/index.js",
    "migrate": "node build/migrate/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "react-router typegen && eslint .",
    "lint:fix": "react-router typegen && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "run-s format:check lint typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "gen:glassfrog": "openapi-ts -f openapi-ts.glassfrog.config.ts",
    "gen:glassfrog:fetch": "curl -fsS https://app.glassfrog.com/api/v5/openapi.json -o openapi/glassfrog.json && yarn gen:glassfrog",
    "gen:glassfrog-v3": "openapi-ts -f openapi-ts.glassfrog-v3.config.ts",
    "gen:glassfrog-v3:fetch": "curl -fsS https://app.glassfrog.com/api/v3/docs/spec.yaml -o openapi/glassfrog-v3.yaml && yarn gen:glassfrog-v3",
    "gen:todoist": "openapi-ts -f openapi-ts.todoist.config.ts",
    "gen:todoist:fetch": "curl -fsS https://developer.todoist.com/openapi.json -o openapi/todoist.json && yarn gen:todoist",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@doist/todoist-sdk": "^13.0.0",
    "@heroui/react": "^3.2.3",
    "@heroui/styles": "^3.2.3",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "better-auth": "^1.6.25",
    "bullmq": "^6.0.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "isbot": "^5.1.36",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "ioredis-mock": "^8.13.1",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "type-fest": "^5.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.10"
  }
}
