{
  "name": "todoist-sync",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "run-p dev:web dev:worker",
    "dev:web": "react-router dev",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "worker": "tsx worker/index.ts",
    "typecheck": "react-router typegen && tsc",
    "lint": "node scripts/biome.mjs check .",
    "lint:fix": "node scripts/biome.mjs check --write .",
    "check": "run-s lint typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "gen:glassfrog": "openapi-ts",
    "gen:glassfrog:fetch": "curl -fsS https://app.glassfrog.com/api/v5/openapi.json -o openapi/glassfrog.json && npm run gen:glassfrog",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@doist/todoist-sdk": "^13.0.0",
    "@heroui/react": "^3.2.3",
    "@heroui/styles": "^3.2.3",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "better-auth": "^1.6.25",
    "bullmq": "^6.0.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "isbot": "^5.1.36",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@hey-api/openapi-ts": "^0.99.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.10"
  }
}
