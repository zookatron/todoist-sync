# --- Datastores (match docker-compose.yml) ---------------------------------
DATABASE_URL="postgres://todoist_sync:todoist_sync@localhost:5432/todoist_sync"
REDIS_URL="redis://localhost:6379"

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:5173"

# Encrypts Todoist tokens and the Glassfrog API key at rest.
# Must be exactly 32 bytes, base64-encoded: openssl rand -base64 32
# Changing this makes every stored credential unreadable.
ENCRYPTION_KEY="replace-me-openssl-rand-base64-32"

# --- Todoist OAuth app ------------------------------------------------------
# Create at https://app.todoist.com/app_console/
# The redirect URI below must match the app console exactly.
TODOIST_CLIENT_ID=""
TODOIST_CLIENT_SECRET=""
TODOIST_REDIRECT_URI="http://localhost:5173/oauth/todoist/callback"

# --- Sync behaviour ---------------------------------------------------------
# How often the scheduled poll runs, in milliseconds.
SYNC_INTERVAL_MS="60000"

# What to do with Todoist projects under the root that Glassfrog doesn't know about.
#   dry-run  log the intent only (safe first run)
#   archive  archive them in Todoist (recoverable)
PRUNE_MODE="archive"

# Set to false once your account exists to close the instance to new signups.
ALLOW_SIGNUP="true"

LOG_LEVEL="info"
