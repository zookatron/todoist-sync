# --- Datastores (match docker-compose.yml) ---------------------------------
DATABASE_URL="postgres://todoist_sync:todoist_sync@localhost:5432/todoist_sync"
REDIS_URL="redis://localhost:6379"

# --- Auth -------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:5173"

# --- Sync behaviour ---------------------------------------------------------
# How often the scheduled poll runs, in milliseconds.
SYNC_INTERVAL_MS="3600000"

# Set to false once your account exists to close the instance to new signups.
ALLOW_SIGNUP="true"

# --- Logging ----------------------------------------------------------------
LOG_LEVEL="info"

# Write logs to a file instead of stdout. Every process that sets this appends to the same
# file, so pointing web and worker at one path gives a single merged timeline.
# docker-compose already sets this to /app/logs/app.log on a shared volume.
# LOG_FILE="./logs/app.log"

# --- Initial user (optional, read only by the `migrate` container) ----------
# Seeds the single user account on first boot, so you can leave ALLOW_SIGNUP=false and
# never expose public signup at all. No-op once that email already exists.
# INITIAL_USER_EMAIL="you@example.com"
# INITIAL_USER_PASSWORD="replace-me-min-12-chars"
# INITIAL_USER_NAME="Admin"
